{
  "name": "bulls-bears-free",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build && node scripts/verify_web.mjs",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "test": "node node_modules/vitest/vitest.mjs run --maxWorkers=2 --testTimeout=20000",
    "refresh": "python -m scripts.web_refresh core"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vite": "^7.1.7",
    "vitest": "5.0.5"
  },
